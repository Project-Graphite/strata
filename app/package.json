{
  "name": "strata",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend && npm run build --workspace server",
    "dev": "npm run dev --workspace server",
    "lint": "oxlint server/src server/test frontend/src frontend/test",
    "test": "npm run test --workspace server && npm run test --workspace frontend",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace server",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace server"
  },
  "devDependencies": {
    "oxlint": "1.86.0"
  }
}
