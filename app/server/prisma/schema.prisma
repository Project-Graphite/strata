generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER         @map("member")
  ADMIN          @map("admin")
  SYSTEM_MANAGER @map("system_manager")
}

enum SpaceRole {
  OWNER  @map("owner")
  EDITOR @map("editor")
  VIEWER @map("viewer")
}

enum ItemKind {
  NOTE         @map("note")
  TASK         @map("task")
  EVENT        @map("event")
  SUBSCRIPTION @map("subscription")
  BOARD        @map("board")
  FILE         @map("file")
  LIST         @map("list")
}

enum LinkKind {
  MENTION    @map("mention")
  REFERENCE  @map("reference")
  ATTACHMENT @map("attachment")
}

enum InvitationKind {
  APP   @map("app")
  SPACE @map("space")
}

enum ShareAccess {
  VIEW @map("view")
  EDIT @map("edit")
}

enum GuestResponse {
  PENDING @map("pending")
  YES     @map("yes")
  NO      @map("no")
  MAYBE   @map("maybe")
}

enum TidyAction {
  ARCHIVE @map("archive")
  TRASH   @map("trash")
  TAG     @map("tag")
  CANCEL  @map("cancel")
}

enum TokenPurpose {
  VERIFY_EMAIL   @map("verify_email")
  CHANGE_EMAIL   @map("change_email")
  RESET_PASSWORD @map("reset_password")
}

model User {
  id                  String                 @id @default(uuid()) @db.Uuid
  email               String                 @unique
  handle              String                 @unique
  displayName         String                 @map("display_name")
  passwordHash        String                 @map("password_hash")
  verifiedAt          DateTime?              @map("verified_at")
  timeZone            String                 @default("Etc/UTC") @map("time_zone")
  tidySummary         Boolean                @default(false) @map("tidy_summary")
  homeCurrency        String?                @map("home_currency")
  isActive            Boolean                @default(true) @map("is_active")
  role                UserRole               @default(MEMBER)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  verificationTokens  VerificationToken[]
  refreshSessions     RefreshSession[]
  twoStepCredential   TwoStepCredential?
  recoveryCodes       RecoveryCode[]
  knownDevices        KnownDevice[]
  signInChallenges    SignInChallenge[]
  personalSpace       Space?                 @relation("PersonalSpace")
  createdSpaces       Space[]                @relation("CreatedSpaces")
  memberships         SpaceMember[]
  createdItems        Item[]                 @relation("CreatedItems")
  updatedItems        Item[]                 @relation("UpdatedItems")
  createdLinks        ItemLink[]
  sentInvitations     Invitation[]           @relation("SentInvitations")
  receivedInvitations Invitation[]           @relation("ReceivedInvitations")
  redemptions         InvitationRedemption[]
  createdShareLinks   ShareLink[]
  activity            ActivityEvent[]
  auditEvents         AuditEvent[]           @relation("AuditSubject")
  auditActions        AuditEvent[]           @relation("AuditActor")
  inbox               InboxNotification[]
  uploadedFiles       File[]
  accessTokens        AccessToken[]
  assignedTasks       Task[]
  dashboards          Dashboard[]
  tidyBatches         TidyBatch[]
  tidyRules           TidyRule[]
  noteVersions        NoteVersion[]
  habitCheckIns       HabitCheckIn[]
  paidSplits          CostSplit[]
  costShares          CostShare[]
  settlementsPaid     Settlement[]           @relation("SettlementFrom")
  settlementsReceived Settlement[]           @relation("SettlementTo")

  @@map("users")
}

model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose @default(VERIFY_EMAIL)
  email     String?
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model RefreshSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  deviceHash  String?   @map("device_hash")
  deviceLabel String    @default("Unknown device") @map("device_label")
  signedInAt  DateTime  @default(now()) @map("signed_in_at")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model TwoStepCredential {
  userId          String    @id @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  confirmedAt     DateTime? @map("confirmed_at")
  lastUsedStep    Int?      @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_step_credentials")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model KnownDevice {
  userId      String   @map("user_id") @db.Uuid
  deviceHash  String   @map("device_hash")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, deviceHash])
  @@map("known_devices")
}

model SignInChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sign_in_challenges")
}

model Space {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  color           String           @default("gray")
  personalOwnerId String?          @unique @map("personal_owner_id") @db.Uuid
  createdById     String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  personalOwner   User?            @relation("PersonalSpace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("CreatedSpaces", fields: [createdById], references: [id], onDelete: SetNull)
  members         SpaceMember[]
  items           Item[]
  tags            Tag[]
  invitations     Invitation[]
  searchDocuments SearchDocument[]
  activity        ActivityEvent[]
  tidyRules       TidyRule[]
  habits          Habit[]
  settlements     Settlement[]

  @@map("spaces")
}

model SpaceMember {
  spaceId  String    @map("space_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     SpaceRole
  joinedAt DateTime  @default(now()) @map("joined_at")
  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

model Item {
  id             String              @id @default(uuid()) @db.Uuid
  spaceId        String              @map("space_id") @db.Uuid
  kind           ItemKind
  title          String              @default("")
  createdById    String?             @map("created_by") @db.Uuid
  updatedById    String?             @map("updated_by") @db.Uuid
  archivedAt     DateTime?           @map("archived_at")
  trashedAt      DateTime?           @map("trashed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  space          Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy      User?               @relation("CreatedItems", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?               @relation("UpdatedItems", fields: [updatedById], references: [id], onDelete: SetNull)
  tags           ItemTag[]
  linksOut       ItemLink[]          @relation("LinkSource")
  linksIn        ItemLink[]          @relation("LinkTarget")
  shareLinks     ShareLink[]
  activity       ActivityEvent[]
  file           File?
  searchDocument SearchDocument?
  task           Task?               @relation("TaskItem")
  listTasks      Task[]              @relation("TaskList")
  subtasks       Task[]              @relation("TaskParent")
  subscription   Subscription?
  prices         SubscriptionPrice[]
  event          Event?
  guests         EventGuest[]
  note           Note?               @relation("NoteItem")
  childNotes     Note[]              @relation("NoteParent")
  noteDocument   NoteDocument?
  noteVersions   NoteVersion[]
  databaseSchema DatabaseSchema?
  properties     NoteProperty[]
  tidyChanges    TidyChange[]
  costSplit      CostSplit?

  @@index([spaceId, updatedAt])
  @@map("items")
}

model Tag {
  id          String      @id @default(uuid()) @db.Uuid
  spaceId     String      @map("space_id") @db.Uuid
  name        String
  color       String      @default("gray")
  createdAt   DateTime    @default(now()) @map("created_at")
  space       Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  items       ItemTag[]
  tidyBatches TidyBatch[]
  tidyRules   TidyRule[]

  @@map("tags")
}

model ItemTag {
  itemId String @map("item_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("item_tags")
}

model ItemLink {
  id           String   @id @default(uuid()) @db.Uuid
  sourceItemId String   @map("source_item_id") @db.Uuid
  targetItemId String   @map("target_item_id") @db.Uuid
  kind         LinkKind
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  source       Item     @relation("LinkSource", fields: [sourceItemId], references: [id], onDelete: Cascade)
  target       Item     @relation("LinkTarget", fields: [targetItemId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sourceItemId, targetItemId, kind])
  @@index([targetItemId])
  @@map("item_links")
}

model SiteSettings {
  id          Int      @id @default(1)
  inviteOnly  Boolean  @default(false) @map("invite_only")
  fileQuotaMb Int      @default(100) @map("file_quota_mb")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Invitation {
  id          String                 @id @default(uuid()) @db.Uuid
  kind        InvitationKind
  spaceId     String?                @map("space_id") @db.Uuid
  role        SpaceRole?
  email       String?
  inviteeId   String?                @map("invitee_id") @db.Uuid
  tokenHash   String                 @unique @map("token_hash")
  inviterId   String?                @map("inviter_id") @db.Uuid
  note        String?
  maxUses     Int                    @default(1) @map("max_uses")
  useCount    Int                    @default(0) @map("use_count")
  expiresAt   DateTime               @map("expires_at")
  revokedAt   DateTime?              @map("revoked_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  space       Space?                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  invitee     User?                  @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter     User?                  @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: SetNull)
  redemptions InvitationRedemption[]

  @@index([spaceId])
  @@index([email])
  @@index([inviteeId])
  @@index([inviterId])
  @@map("invitations")
}

model InvitationRedemption {
  invitationId String     @map("invitation_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  redeemedAt   DateTime   @default(now()) @map("redeemed_at")
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([invitationId, userId])
  @@index([userId])
  @@map("invitation_redemptions")
}

model ShareLink {
  id          String      @id @default(uuid()) @db.Uuid
  itemId      String      @map("item_id") @db.Uuid
  access      ShareAccess
  tokenHash   String      @unique @map("token_hash")
  expiresAt   DateTime    @map("expires_at")
  revokedAt   DateTime?   @map("revoked_at")
  createdById String?     @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@map("share_links")
}

model ActivityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  itemId    String?  @map("item_id") @db.Uuid
  verb      String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([spaceId, createdAt])
  @@index([itemId])
  @@map("activity_events")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation("AuditSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

model InboxNotification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("inbox_notifications")
}

model ScheduledJob {
  id        String    @id @default(uuid()) @db.Uuid
  kind      String
  runAt     DateTime  @map("run_at")
  payload   Json      @default("{}")
  claimedAt DateTime? @map("claimed_at")
  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  doneAt    DateTime? @map("done_at")
  failedAt  DateTime? @map("failed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([runAt])
  @@map("scheduled_jobs")
}

model FileBlob {
  sha256    String   @id
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")
  files     File[]

  @@map("file_blobs")
}

model File {
  itemId       String   @id @map("item_id") @db.Uuid
  sha256       String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  width        Int?
  height       Int?
  uploadedById String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  blob         FileBlob @relation(fields: [sha256], references: [sha256], onDelete: Restrict)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([sha256])
  @@index([uploadedById])
  @@map("files")
}

model AccessToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("access_tokens")
}

model SearchDocument {
  itemId    String   @id @map("item_id") @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  title     String   @default("")
  bodyText  String   @default("") @map("body_text")
  updatedAt DateTime @default(now()) @map("updated_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@map("search_documents")
}

model Task {
  itemId          String    @id @map("item_id") @db.Uuid
  listId          String?   @map("list_id") @db.Uuid
  parentId        String?   @map("parent_id") @db.Uuid
  dueDate         DateTime? @map("due_date") @db.Date
  dueTime         String?   @map("due_time")
  timeZone        String    @map("time_zone")
  repeatRule      String?   @map("repeat_rule")
  reminderMinutes Int?      @map("reminder_minutes")
  assigneeId      String?   @map("assignee_id") @db.Uuid
  priority        Int       @default(0)
  position        Float     @default(0)
  completedAt     DateTime? @map("completed_at")
  item            Item      @relation("TaskItem", fields: [itemId], references: [id], onDelete: Cascade)
  list            Item?     @relation("TaskList", fields: [listId], references: [id], onDelete: SetNull)
  parent          Item?     @relation("TaskParent", fields: [parentId], references: [id], onDelete: SetNull)
  assignee        User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([parentId])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("tasks")
}

model Subscription {
  itemId       String    @id @map("item_id") @db.Uuid
  amountMinor  Int       @map("amount_minor")
  currency     String
  repeatRule   String    @map("repeat_rule")
  startDate    DateTime  @map("start_date") @db.Date
  nextRenewal  DateTime  @map("next_renewal") @db.Date
  timeZone     String    @map("time_zone")
  trialEndsOn  DateTime? @map("trial_ends_on") @db.Date
  noticeDays   Int?      @map("notice_days")
  category     String    @default("other")
  paymentLabel String?   @map("payment_label")
  cancelUrl    String?   @map("cancel_url")
  supportUrl   String?   @map("support_url")
  usedBy       String?   @map("used_by")
  reminderDays Int?      @map("reminder_days")
  lastUsedOn   DateTime? @map("last_used_on") @db.Date
  cancelledOn  DateTime? @map("cancelled_on") @db.Date
  item         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([nextRenewal])
  @@map("subscriptions")
}

model SubscriptionPrice {
  id            String   @id @default(uuid()) @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  amountMinor   Int      @map("amount_minor")
  currency      String
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, effectiveFrom])
  @@map("subscription_prices")
}

model Dashboard {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  position  Int      @default(0)
  layout    Json
  showFrom  Int?     @map("show_from")
  showUntil Int?     @map("show_until")
  showOn    String   @default("any") @map("show_on")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("dashboards")
}

model Event {
  itemId          String   @id @map("item_id") @db.Uuid
  startsOn        DateTime @map("starts_on") @db.Date
  startTime       String?  @map("start_time")
  endsOn          DateTime @map("ends_on") @db.Date
  endTime         String?  @map("end_time")
  timeZone        String   @map("time_zone")
  repeatRule      String?  @map("repeat_rule")
  location        String?
  meetingUrl      String?  @map("meeting_url")
  description     String   @default("")
  reminderMinutes Int?     @map("reminder_minutes")
  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([startsOn])
  @@map("events")
}

model EventGuest {
  id          String        @id @default(uuid()) @db.Uuid
  itemId      String        @map("item_id") @db.Uuid
  name        String
  email       String?
  tokenHash   String        @unique @map("token_hash")
  response    GuestResponse @default(PENDING)
  note        String?
  invitedAt   DateTime      @default(now()) @map("invited_at")
  respondedAt DateTime?     @map("responded_at")
  item        Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("event_guests")
}

model TidyBatch {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  action    TidyAction
  tagId     String?      @map("tag_id") @db.Uuid
  ruleId    String?      @map("rule_id") @db.Uuid
  itemCount Int          @map("item_count")
  createdAt DateTime     @default(now()) @map("created_at")
  undoneAt  DateTime?    @map("undone_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       Tag?         @relation(fields: [tagId], references: [id], onDelete: SetNull)
  rule      TidyRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  changes   TidyChange[]

  @@index([userId, createdAt])
  @@map("tidy_batches")
}

model TidyChange {
  batchId String    @map("batch_id") @db.Uuid
  itemId  String    @map("item_id") @db.Uuid
  batch   TidyBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  item    Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([batchId, itemId])
  @@index([itemId])
  @@map("tidy_changes")
}

model TidyRule {
  id            String      @id @default(uuid()) @db.Uuid
  spaceId       String      @map("space_id") @db.Uuid
  createdById   String      @map("created_by") @db.Uuid
  titleContains String      @default("") @map("title_contains")
  kind          ItemKind?
  fileType      String?     @map("file_type")
  tagId         String      @map("tag_id") @db.Uuid
  enabled       Boolean     @default(true)
  checkedUntil  DateTime    @map("checked_until")
  createdAt     DateTime    @default(now()) @map("created_at")
  space         Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy     User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  batches       TidyBatch[]

  @@index([spaceId])
  @@map("tidy_rules")
}

model ExchangeRate {
  currency    String   @id
  perEuro     Float    @map("per_euro")
  publishedOn DateTime @map("published_on") @db.Date
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("exchange_rates")
}

model Note {
  itemId   String    @id @map("item_id") @db.Uuid
  parentId String?   @map("parent_id") @db.Uuid
  position Float     @default(0)
  icon     String?
  pinnedAt DateTime? @map("pinned_at")
  template Boolean   @default(false)
  item     Item      @relation("NoteItem", fields: [itemId], references: [id], onDelete: Cascade)
  parent   Item?     @relation("NoteParent", fields: [parentId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@map("notes")
}

model NoteDocument {
  itemId    String   @id @map("item_id") @db.Uuid
  state     Bytes
  updatedAt DateTime @updatedAt @map("updated_at")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("note_documents")
}

model NoteVersion {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  state       Bytes
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@map("note_versions")
}

model DatabaseSchema {
  itemId     String   @id @map("item_id") @db.Uuid
  properties Json     @default("[]")
  view       String   @default("table")
  groupBy    String?  @map("group_by")
  dateBy     String?  @map("date_by")
  updatedAt  DateTime @updatedAt @map("updated_at")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("database_schemas")
}

model NoteProperty {
  itemId     String @map("item_id") @db.Uuid
  propertyId String @map("property_id")
  value      Json
  item       Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, propertyId])
  @@map("note_properties")
}

model Habit {
  id        String         @id @default(uuid()) @db.Uuid
  spaceId   String         @map("space_id") @db.Uuid
  name      String
  perWeek   Int            @default(7) @map("per_week")
  position  Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at")
  space     Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  checkIns  HabitCheckIn[]

  @@index([spaceId, position])
  @@map("habits")
}

model HabitCheckIn {
  habitId   String   @map("habit_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([habitId, userId, day])
  @@index([userId, day])
  @@map("habit_check_ins")
}

model CostSplit {
  itemId  String      @id @map("item_id") @db.Uuid
  payerId String      @map("payer_id") @db.Uuid
  item    Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  payer   User        @relation(fields: [payerId], references: [id], onDelete: Cascade)
  shares  CostShare[]

  @@index([payerId])
  @@map("cost_splits")
}

model CostShare {
  itemId String    @map("item_id") @db.Uuid
  userId String    @map("user_id") @db.Uuid
  weight Int       @default(1)
  split  CostSplit @relation(fields: [itemId], references: [itemId], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@index([userId])
  @@map("cost_shares")
}

model Settlement {
  id          String   @id @default(uuid()) @db.Uuid
  spaceId     String   @map("space_id") @db.Uuid
  fromUserId  String   @map("from_user_id") @db.Uuid
  toUserId    String   @map("to_user_id") @db.Uuid
  amountMinor Int      @map("amount_minor")
  currency    String
  month       String
  createdAt   DateTime @default(now()) @map("created_at")
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  fromUser    User     @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([spaceId, month])
  @@map("settlements")
}
