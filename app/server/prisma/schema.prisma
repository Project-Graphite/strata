generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER         @map("member")
  ADMIN          @map("admin")
  SYSTEM_MANAGER @map("system_manager")
}

enum SpaceRole {
  OWNER  @map("owner")
  EDITOR @map("editor")
  VIEWER @map("viewer")
}

enum ItemKind {
  NOTE         @map("note")
  TASK         @map("task")
  EVENT        @map("event")
  SUBSCRIPTION @map("subscription")
  BOARD        @map("board")
  FILE         @map("file")
}

enum LinkKind {
  MENTION    @map("mention")
  REFERENCE  @map("reference")
  ATTACHMENT @map("attachment")
}

enum InvitationKind {
  APP   @map("app")
  SPACE @map("space")
}

enum ShareAccess {
  VIEW @map("view")
  EDIT @map("edit")
}

enum TokenPurpose {
  VERIFY_EMAIL   @map("verify_email")
  CHANGE_EMAIL   @map("change_email")
  RESET_PASSWORD @map("reset_password")
}

model User {
  id                  String                 @id @default(uuid()) @db.Uuid
  email               String                 @unique
  handle              String                 @unique
  displayName         String                 @map("display_name")
  passwordHash        String                 @map("password_hash")
  verifiedAt          DateTime?              @map("verified_at")
  timeZone            String                 @default("Etc/UTC") @map("time_zone")
  isActive            Boolean                @default(true) @map("is_active")
  role                UserRole               @default(MEMBER)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  verificationTokens  VerificationToken[]
  refreshSessions     RefreshSession[]
  twoStepCredential   TwoStepCredential?
  recoveryCodes       RecoveryCode[]
  knownDevices        KnownDevice[]
  signInChallenges    SignInChallenge[]
  personalSpace       Space?                 @relation("PersonalSpace")
  createdSpaces       Space[]                @relation("CreatedSpaces")
  memberships         SpaceMember[]
  createdItems        Item[]                 @relation("CreatedItems")
  updatedItems        Item[]                 @relation("UpdatedItems")
  createdLinks        ItemLink[]
  sentInvitations     Invitation[]           @relation("SentInvitations")
  receivedInvitations Invitation[]           @relation("ReceivedInvitations")
  redemptions         InvitationRedemption[]
  createdShareLinks   ShareLink[]
  activity            ActivityEvent[]
  auditEvents         AuditEvent[]           @relation("AuditSubject")
  auditActions        AuditEvent[]           @relation("AuditActor")
  inbox               InboxNotification[]
  uploadedFiles       File[]
  accessTokens        AccessToken[]

  @@map("users")
}

model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose @default(VERIFY_EMAIL)
  email     String?
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model RefreshSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  deviceHash  String?   @map("device_hash")
  deviceLabel String    @default("Unknown device") @map("device_label")
  signedInAt  DateTime  @default(now()) @map("signed_in_at")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model TwoStepCredential {
  userId          String    @id @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  confirmedAt     DateTime? @map("confirmed_at")
  lastUsedStep    Int?      @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_step_credentials")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model KnownDevice {
  userId      String   @map("user_id") @db.Uuid
  deviceHash  String   @map("device_hash")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, deviceHash])
  @@map("known_devices")
}

model SignInChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sign_in_challenges")
}

model Space {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  color           String          @default("gray")
  personalOwnerId String?         @unique @map("personal_owner_id") @db.Uuid
  createdById     String?         @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  personalOwner   User?           @relation("PersonalSpace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("CreatedSpaces", fields: [createdById], references: [id], onDelete: SetNull)
  members         SpaceMember[]
  items           Item[]
  tags            Tag[]
  invitations     Invitation[]
  activity        ActivityEvent[]

  @@map("spaces")
}

model SpaceMember {
  spaceId  String    @map("space_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     SpaceRole
  joinedAt DateTime  @default(now()) @map("joined_at")
  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

model Item {
  id          String          @id @default(uuid()) @db.Uuid
  spaceId     String          @map("space_id") @db.Uuid
  kind        ItemKind
  title       String          @default("")
  createdById String?         @map("created_by") @db.Uuid
  updatedById String?         @map("updated_by") @db.Uuid
  archivedAt  DateTime?       @map("archived_at")
  trashedAt   DateTime?       @map("trashed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  space       Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("CreatedItems", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?           @relation("UpdatedItems", fields: [updatedById], references: [id], onDelete: SetNull)
  tags        ItemTag[]
  linksOut    ItemLink[]      @relation("LinkSource")
  linksIn     ItemLink[]      @relation("LinkTarget")
  shareLinks  ShareLink[]
  activity    ActivityEvent[]
  file        File?

  @@index([spaceId, updatedAt])
  @@map("items")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  spaceId   String    @map("space_id") @db.Uuid
  name      String
  color     String    @default("gray")
  createdAt DateTime  @default(now()) @map("created_at")
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  items     ItemTag[]

  @@map("tags")
}

model ItemTag {
  itemId String @map("item_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("item_tags")
}

model ItemLink {
  id           String   @id @default(uuid()) @db.Uuid
  sourceItemId String   @map("source_item_id") @db.Uuid
  targetItemId String   @map("target_item_id") @db.Uuid
  kind         LinkKind
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  source       Item     @relation("LinkSource", fields: [sourceItemId], references: [id], onDelete: Cascade)
  target       Item     @relation("LinkTarget", fields: [targetItemId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sourceItemId, targetItemId, kind])
  @@index([targetItemId])
  @@map("item_links")
}

model SiteSettings {
  id          Int      @id @default(1)
  inviteOnly  Boolean  @default(false) @map("invite_only")
  fileQuotaMb Int      @default(100) @map("file_quota_mb")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Invitation {
  id          String                 @id @default(uuid()) @db.Uuid
  kind        InvitationKind
  spaceId     String?                @map("space_id") @db.Uuid
  role        SpaceRole?
  email       String?
  inviteeId   String?                @map("invitee_id") @db.Uuid
  tokenHash   String                 @unique @map("token_hash")
  inviterId   String?                @map("inviter_id") @db.Uuid
  note        String?
  maxUses     Int                    @default(1) @map("max_uses")
  useCount    Int                    @default(0) @map("use_count")
  expiresAt   DateTime               @map("expires_at")
  revokedAt   DateTime?              @map("revoked_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  space       Space?                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  invitee     User?                  @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter     User?                  @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: SetNull)
  redemptions InvitationRedemption[]

  @@index([spaceId])
  @@index([email])
  @@index([inviteeId])
  @@index([inviterId])
  @@map("invitations")
}

model InvitationRedemption {
  invitationId String     @map("invitation_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  redeemedAt   DateTime   @default(now()) @map("redeemed_at")
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([invitationId, userId])
  @@index([userId])
  @@map("invitation_redemptions")
}

model ShareLink {
  id          String      @id @default(uuid()) @db.Uuid
  itemId      String      @map("item_id") @db.Uuid
  access      ShareAccess
  tokenHash   String      @unique @map("token_hash")
  expiresAt   DateTime    @map("expires_at")
  revokedAt   DateTime?   @map("revoked_at")
  createdById String?     @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@map("share_links")
}

model ActivityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  itemId    String?  @map("item_id") @db.Uuid
  verb      String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([spaceId, createdAt])
  @@index([itemId])
  @@map("activity_events")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation("AuditSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

model InboxNotification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("inbox_notifications")
}

model ScheduledJob {
  id        String    @id @default(uuid()) @db.Uuid
  kind      String
  runAt     DateTime  @map("run_at")
  payload   Json      @default("{}")
  claimedAt DateTime? @map("claimed_at")
  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  doneAt    DateTime? @map("done_at")
  failedAt  DateTime? @map("failed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([runAt])
  @@map("scheduled_jobs")
}

model FileBlob {
  sha256    String   @id
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")
  files     File[]

  @@map("file_blobs")
}

model File {
  itemId       String   @id @map("item_id") @db.Uuid
  sha256       String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  width        Int?
  height       Int?
  uploadedById String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  blob         FileBlob @relation(fields: [sha256], references: [sha256], onDelete: Restrict)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([sha256])
  @@index([uploadedById])
  @@map("files")
}

model AccessToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("access_tokens")
}
