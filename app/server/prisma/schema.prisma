generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER         @map("member")
  ADMIN          @map("admin")
  SYSTEM_MANAGER @map("system_manager")
}

enum SpaceRole {
  OWNER  @map("owner")
  EDITOR @map("editor")
  VIEWER @map("viewer")
}

enum ItemKind {
  NOTE         @map("note")
  TASK         @map("task")
  EVENT        @map("event")
  SUBSCRIPTION @map("subscription")
  BOARD        @map("board")
  FILE         @map("file")
}

enum LinkKind {
  MENTION    @map("mention")
  REFERENCE  @map("reference")
  ATTACHMENT @map("attachment")
}

enum TokenPurpose {
  VERIFY_EMAIL   @map("verify_email")
  CHANGE_EMAIL   @map("change_email")
  RESET_PASSWORD @map("reset_password")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  handle             String              @unique
  displayName        String              @map("display_name")
  passwordHash       String              @map("password_hash")
  verifiedAt         DateTime?           @map("verified_at")
  timeZone           String              @default("Etc/UTC") @map("time_zone")
  isActive           Boolean             @default(true) @map("is_active")
  role               UserRole            @default(MEMBER)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  verificationTokens VerificationToken[]
  refreshSessions    RefreshSession[]
  twoStepCredential  TwoStepCredential?
  recoveryCodes      RecoveryCode[]
  knownDevices       KnownDevice[]
  signInChallenges   SignInChallenge[]
  personalSpace      Space?              @relation("PersonalSpace")
  createdSpaces      Space[]             @relation("CreatedSpaces")
  memberships        SpaceMember[]
  createdItems       Item[]              @relation("CreatedItems")
  updatedItems       Item[]              @relation("UpdatedItems")
  createdLinks       ItemLink[]

  @@map("users")
}

model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose @default(VERIFY_EMAIL)
  email     String?
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model RefreshSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  deviceHash  String?   @map("device_hash")
  deviceLabel String    @default("Unknown device") @map("device_label")
  signedInAt  DateTime  @default(now()) @map("signed_in_at")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model TwoStepCredential {
  userId          String    @id @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  confirmedAt     DateTime? @map("confirmed_at")
  lastUsedStep    Int?      @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_step_credentials")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model KnownDevice {
  userId      String   @map("user_id") @db.Uuid
  deviceHash  String   @map("device_hash")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, deviceHash])
  @@map("known_devices")
}

model SignInChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sign_in_challenges")
}

model Space {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  color           String        @default("gray")
  personalOwnerId String?       @unique @map("personal_owner_id") @db.Uuid
  createdById     String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  personalOwner   User?         @relation("PersonalSpace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  createdBy       User?         @relation("CreatedSpaces", fields: [createdById], references: [id], onDelete: SetNull)
  members         SpaceMember[]
  items           Item[]
  tags            Tag[]

  @@map("spaces")
}

model SpaceMember {
  spaceId  String    @map("space_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     SpaceRole
  joinedAt DateTime  @default(now()) @map("joined_at")
  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

model Item {
  id          String     @id @default(uuid()) @db.Uuid
  spaceId     String     @map("space_id") @db.Uuid
  kind        ItemKind
  title       String     @default("")
  createdById String?    @map("created_by") @db.Uuid
  updatedById String?    @map("updated_by") @db.Uuid
  archivedAt  DateTime?  @map("archived_at")
  trashedAt   DateTime?  @map("trashed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  space       Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy   User?      @relation("CreatedItems", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?      @relation("UpdatedItems", fields: [updatedById], references: [id], onDelete: SetNull)
  tags        ItemTag[]
  linksOut    ItemLink[] @relation("LinkSource")
  linksIn     ItemLink[] @relation("LinkTarget")

  @@index([spaceId, updatedAt])
  @@map("items")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  spaceId   String    @map("space_id") @db.Uuid
  name      String
  color     String    @default("gray")
  createdAt DateTime  @default(now()) @map("created_at")
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  items     ItemTag[]

  @@map("tags")
}

model ItemTag {
  itemId String @map("item_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("item_tags")
}

model ItemLink {
  id           String   @id @default(uuid()) @db.Uuid
  sourceItemId String   @map("source_item_id") @db.Uuid
  targetItemId String   @map("target_item_id") @db.Uuid
  kind         LinkKind
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  source       Item     @relation("LinkSource", fields: [sourceItemId], references: [id], onDelete: Cascade)
  target       Item     @relation("LinkTarget", fields: [targetItemId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sourceItemId, targetItemId, kind])
  @@index([targetItemId])
  @@map("item_links")
}
